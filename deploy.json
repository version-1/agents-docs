{
  "items": [
    {
      "source": "codex/skills",
      "tags": ["skills"],
      "destination": "~/.codex/skills",
      "replace": true,
      "preserve": [
        ".system"
      ],
      "exclude": [
        "**/.DS_Store",
        "internal/deprecated",
        "internal/depricated"
      ]
    },
    {
      "source": "codex/rules",
      "tags": ["rules"],
      "destination": "~/.codex/rules",
      "replace": false
    },
    {
      "source": "codex/bin",
      "tags": ["bin"],
      "destination": "~/.codex/bin",
      "replace": false,
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "codex/agents",
      "tags": ["agents"],
      "destination": "~/.codex/agents",
      "replace": true,
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "codex/AGENTS.md",
      "tags": ["instructions"],
      "destination": "~/.codex/AGENTS.md",
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "codex/config.toml",
      "tags": ["config"],
      "destination": "~/.codex/config.toml",
      "template": true,
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "codex/skills",
      "destination": "~/.claude/skills",
      "tags": ["skills"],
      "replace": true,
      "flatten": true,
      "exclude": [
        "**/.DS_Store",
        "internal/deprecated",
        "internal/depricated"
      ]
    },
    {
      "source": "claude/agents",
      "tags": ["agents"],
      "destination": "~/.claude/agents",
      "replace": true,
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "claude/CLAUDE.md",
      "tags": ["instructions"],
      "destination": "~/.claude/CLAUDE.md",
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "claude/settings.json",
      "tags": ["config"],
      "destination": "~/.claude/settings.json",
      "exclude": [
        "**/.DS_Store"
      ]
    },
    {
      "source": "cursor/cli-config.json",
      "tags": ["config"],
      "destination": "~/.cursor/cli-config.json",
      "mergeJSON": true,
      "exclude": [
        "**/.DS_Store"
      ]
    }
  ]
}
