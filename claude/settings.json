{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoUpdatesChannel": "stable",
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "rubygems.org"
      ]
    }
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Agent",
      "Read(~/**)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(git worktree prune *)",
      "Bash(gh pr edit *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr merge *)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)",
      "Bash(kubectl)",
      "Bash(kubectl *)",
      "Bash(aws)",
      "Bash(aws *)",
      "Bash(gcloud)",
      "Bash(gcloud *)",
      "Bash(vercel deploy)",
      "Bash(vercel deploy *)",
      "Bash(psql)",
      "Bash(psql *)",
      "Bash(mysql)",
      "Bash(mysql *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(pnpm publish)",
      "Bash(pnpm publish *)",
      "Bash(gem push *)",
      "Bash(docker push *)",
      "Bash(cp -r *)",
      "Bash(chmod)",
      "Bash(chmod *)",
      "Bash(curl)",
      "Bash(curl *)",
      "Bash(wget)",
      "Bash(wget *)",
      "Bash(ssh)",
      "Bash(ssh *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo rm *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git clean -fd)",
      "Bash(git clean -fd *)",
      "Bash(docker system prune)",
      "Bash(docker system prune *)",
      "Bash(terraform destroy)",
      "Bash(terraform destroy *)",
      "Bash(gh repo delete *)",
      "Bash(drop)",
      "Bash(drop *)",
      "Bash(truncate)",
      "Bash(truncate *)",
      "Bash(chown)",
      "Bash(chown *)",
      "Bash(scp)",
      "Bash(scp *)",
      "Read(*.env*)",
      "Read(**/*.env*)",
      "Read(~/**/*.env*)",
      "Read(./secrets/**)"
    ]
  },
  "env": {
    "EDITOR": "claude-vim",
    "VISUAL": "claude-vim"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "companyAnnouncements": []
}
